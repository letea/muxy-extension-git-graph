{
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.10"
  },
  "muxy": {
    "$schema": "https://raw.githubusercontent.com/muxy-app/muxy/main/docs/extensions/schema/manifest.schema.json",
    "description": "Commit graph across all branches",
    "permissions": ["git:read", "commands:exec", "panels:write", "tabs:write", "worktrees:read"],
    "events": ["worktree.headChanged"],
    "tabTypes": [
      { "id": "graph", "title": "Git Graph", "entry": "tab/index.html" }
    ],
    "panels": [
      {
        "id": "graph",
        "title": "Git Graph",
        "entry": "panel/index.html",
        "mode": "pinned",
        "position": "right",
        "icon": { "symbol": "point.3.connected.trianglepath.dotted" }
      }
    ],
    "commands": [
      { "id": "open-graph-tab", "title": "Git Graph: Open Graph", "action": { "kind": "openTab", "tabType": "graph" }, "defaultShortcut": "cmd+shift+g" },
      { "id": "toggle-graph-panel", "title": "Git Graph: Toggle Panel", "action": { "kind": "togglePanel", "panel": "graph" } },
      { "id": "refresh-graph", "title": "Git Graph: Refresh" }
    ],
    "topbarItems": [
      { "id": "graph", "command": "open-graph-tab", "icon": { "symbol": "point.3.connected.trianglepath.dotted" }, "tooltip": "Open Git Graph" }
    ]
  },
  "name": "git-graph",
  "private": true,
  "scripts": {
    "build": "vite build && node scripts/copy-manifest.mjs",
    "dev": "vite",
    "test": "vitest run",
    "update-skill": "node -e \"const fs=require('fs'),p=require('path');const url='https://raw.githubusercontent.com/muxy-app/muxy/main/Muxy/Resources/skills/muxy-extension/SKILL.md';fetch(url).then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);return r.text()}).then(t=>{for(const d of ['.claude/skills/muxy-extension','.agents/skills/muxy-extension']){fs.mkdirSync(d,{recursive:true});fs.writeFileSync(p.join(d,'SKILL.md'),t);console.log('Updated '+p.join(d,'SKILL.md'))}}).catch(e=>{console.error('Failed to update skill:',e.message);process.exit(1)})\""
  },
  "type": "module",
  "version": "0.1.0"
}
